<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="profileName"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <moe.matsuri.nb4a.ui.SimpleMenuPreference
        app:defaultValue="2"
        app:entries="@array/hysteria_version"
        app:entryValues="@array/hysteria_version"
        app:icon="@drawable/ic_baseline_update_24"
        app:key="protocolVersion"
        app:title="@string/protocol_version"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">

        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPorts"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="serverObfs"
            app:title="@string/hysteria_obfs"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/hysteria_auth_type"
            app:entryValues="@array/int_array_3"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="serverAuthType"
            app:title="@string/hysteria_auth_type"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="serverPassword"
            app:title="@string/hysteria_auth_payload" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="https"
            app:entries="@array/hysteria_protocol"
            app:entryValues="@array/int_array_3"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="serverProtocol"
            app:title="@string/protocol"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="serverSNI"
            app:title="@string/sni"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="serverALPN"
            app:title="@string/alpn"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="serverCertificates"
            app:title="@string/certificates"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_notification_enhanced_encryption"
            app:key="serverAllowInsecure"
            app:summary="@string/allow_insecure_sum"
            app:title="@string/allow_insecure" />
        <EditTextPreference
            app:icon="@drawable/ic_file_file_upload"
            app:key="serverUploadSpeed"
            app:title="@string/hysteria_upload_mbps"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_download_24"
            app:key="serverDownloadSpeed"
            app:title="@string/hysteria_download_mbps"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="serverStreamReceiveWindow"
            app:title="@string/hysteria_stream_receive_window"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_transform_24"
            app:key="serverConnectionReceiveWindow"
            app:title="@string/hysteria_connection_receive_window"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_multiple_stop_24"
            app:key="serverDisableMtuDiscovery"
            app:title="@string/hysteria_disable_mtu_discovery" />
        <EditTextPreference
            app:key="hopInterval"
            app:title="@string/hop_interval"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="hopIntervalMax"
            app:summary="Optional, randomizes hop interval between the two values. Leave blank/0 to disable."
            app:title="Hop Interval Max (seconds)"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="salamander"
            app:entries="@array/hysteria2_obfs_type"
            app:entryValues="@array/hysteria2_obfs_type"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="obfsType"
            app:title="Obfuscation Type"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="obfsGeckoMinPacketSize"
            app:title="Gecko Min Packet Size"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="obfsGeckoMaxPacketSize"
            app:title="Gecko Max Packet Size"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/hysteria2_bbr_profile"
            app:entryValues="@array/hysteria2_bbr_profile"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="bbrProfile"
            app:summary="Optional, leave unset for sing-box's default"
            app:title="BBR Profile" />
        <SwitchPreference
            app:key="disableChromeParrot"
            app:title="Disable Chrome QUIC Fingerprint Parroting" />
        <EditTextPreference
            app:key="quicIdleTimeout"
            app:summary="Seconds. Leave blank/0 for sing-box's default."
            app:title="QUIC Idle Timeout" />
        <EditTextPreference
            app:key="quicKeepAlivePeriod"
            app:summary="Seconds. Leave blank/0 for sing-box's default."
            app:title="QUIC Keep-Alive Period" />
        <EditTextPreference
            app:key="quicMaxConcurrentStreams"
            app:summary="Leave blank/0 for sing-box's default."
            app:title="QUIC Max Concurrent Streams" />
        <EditTextPreference
            app:key="quicInitialPacketSize"
            app:summary="Leave blank/0 for sing-box's default."
            app:title="QUIC Initial Packet Size" />
    </PreferenceCategory>

</PreferenceScreen>

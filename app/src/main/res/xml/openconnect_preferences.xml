<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:summary="Leave blank/0 to omit and let the server default apply"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="anyconnect"
            app:entries="@array/openconnect_flavor"
            app:entryValues="@array/openconnect_flavor"
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="flavor"
            app:title="Flavor"
            app:summary="Cisco AnyConnect / GlobalProtect / Fortinet / F5 / Pulse / Juniper"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_person_24"
            app:key="username"
            app:title="@string/username"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_settings_password"
            app:key="password"
            app:title="@string/password" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_person_24"
            app:key="authGroup"
            app:title="Auth Group"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_settings_password"
            app:key="cookie"
            app:title="Session Cookie"
            app:summary="Use instead of username/password if you already have one" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="userAgent"
            app:title="User Agent"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/security_settings">
        <SwitchPreference
            app:icon="@drawable/ic_notification_enhanced_encryption"
            app:key="insecure"
            app:title="@string/allow_insecure" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="tlsServerName"
            app:title="TLS Server Name"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="caCertificate"
            app:title="CA Certificate (PEM)" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="clientCertificate"
            app:title="Client Certificate (PEM)" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="clientKey"
            app:title="Client Key (PEM)" />
        <EditTextPreference
            app:icon="@drawable/ic_settings_password"
            app:key="clientKeyPassword"
            app:title="Client Key Password" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Connection Settings">
        <SwitchPreference
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="noUdp"
            app:title="Disable UDP (DTLS)"
            app:summary="Force TCP-only tunneling" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="mtu"
            app:title="MTU"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>

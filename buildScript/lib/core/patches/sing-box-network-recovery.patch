--- /dev/null
+++ b/protocol/group/weighted_latency.go
@@ -0,0 +1,95 @@
+package group
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// Active browser connections can remain idle for minutes. Only connections
+// awaiting their first response contribute to setup pressure on a path.
+type responseStats struct {
+	delay      atomic.Int64
+	observedAt atomic.Int64
+	pending    atomic.Int64
+}
+
+func (s *responseStats) observe(sample time.Duration) {
+	if sample < time.Millisecond {
+		sample = time.Millisecond
+	}
+	for {
+		old := s.delay.Load()
+		next := int64(sample)
+		// React immediately to a slower response, recover gradually as faster
+		// responses arrive. A local mux allocation is never a sample.
+		if old > next {
+			next = old - (old-next)/8
+		}
+		if s.delay.CompareAndSwap(old, next) {
+			break
+		}
+	}
+	s.observedAt.Store(time.Now().UnixNano())
+}
+
+func (s *responseStats) score(now time.Time) (float64, bool) {
+	delay := s.delay.Load()
+	if delay == 0 || now.Sub(time.Unix(0, s.observedAt.Load())) > time.Minute {
+		return 0, false
+	}
+	pending := s.pending.Load()
+	if pending < 0 {
+		pending = 0
+	}
+	return float64(delay) * float64(pending+1), true
+}
+
+func (w *Weighted) ensureResponseStatsLocked() {
+	if len(w.responses) == len(w.health) {
+		return
+	}
+	w.responses = make([]*responseStats, len(w.health))
+	for i := range w.responses {
+		w.responses[i] = new(responseStats)
+	}
+}
+
+func (w *Weighted) responseStats(index int) *responseStats {
+	w.pickMu.Lock()
+	defer w.pickMu.Unlock()
+	w.ensureResponseStatsLocked()
+	return w.responses[index]
+}
+
+type responseTracker struct {
+	stats   *responseStats
+	created time.Time
+	written atomic.Pointer[time.Time]
+	once    sync.Once
+}
+
+func newResponseTracker(stats *responseStats) *responseTracker {
+	stats.pending.Add(1)
+	return &responseTracker{stats: stats, created: time.Now()}
+}
+
+func (t *responseTracker) write() {
+	if t.written.Load() == nil {
+		now := time.Now()
+		t.written.CompareAndSwap(nil, &now)
+	}
+}
+
+func (t *responseTracker) response() {
+	t.once.Do(func() {
+		t.stats.pending.Add(-1)
+		start := t.created
+		if written := t.written.Load(); written != nil {
+			start = *written
+		}
+		t.stats.observe(time.Since(start))
+	})
+}
+
+func (t *responseTracker) close() { t.once.Do(func() { t.stats.pending.Add(-1) }) }

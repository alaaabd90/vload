+// A pending dial follows its physical network's lifetime. A new epoch must
+// never inherit a cancellation or outcome from the previous Android Network.
+func (w *Weighted) memberNetworkContext(index int) context.Context {
+	w.networkMu.Lock()
+	defer w.networkMu.Unlock()
+	if w.networkEpochs == nil {
+		w.networkEpochs = make(map[int]memberNetwork)
+	}
+	if epoch, ok := w.networkEpochs[index]; ok {
+		return epoch.ctx
+	}
+	parent := w.ctx
+	if parent == nil {
+		parent = context.Background()
+	}
+	ctx, cancel := context.WithCancel(parent)
+	if !w.networkAvailable(index) {
+		cancel()
+	}
+	w.networkEpochs[index] = memberNetwork{ctx, cancel}
+	return ctx

+package group
+
+import (
+	"context"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"testing"
+	"time"
+)
+
+type replacedNetworkOutbound struct {
+	scriptedOutbound
+	started chan struct{}
+}
+
+func (f *replacedNetworkOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if f.calls.Add(1) == 1 {
+		close(f.started)
+		<-ctx.Done()
+		// Android can publish the replacement before the old dial unwinds.
+		time.Sleep(100 * time.Millisecond)
+		return nil, ctx.Err()
+	}
+	client, server := net.Pipe()
+	server.Close()
+	return client, nil
+}
+
+func TestSecondaryNetworkReplacementDuringPendingDial(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{delay: 5 * time.Second}, &scriptedOutbound{})
+	replacement := &replacedNetworkOutbound{started: make(chan struct{})}
+	w.members[1].outbound = replacement
+	w.limiters[0].limit.Store(100)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		conn, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+		if conn != nil {
+			conn.Close()
+		}
+		done <- err
+	}()
+	select {
+	case <-replacement.started:
+	case <-ctx.Done():
+		t.Fatal("secondary dial did not start")
+	}
+	w.UpdateAvailability(1, false)
+	w.UpdateAvailability(1, true)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("replacement network was ignored while old dial unwound")
+	}
+}
+
+func TestNetworkAppearingAfterHedgeTimerIsUsed(t *testing.T) {
+	slow := &scriptedOutbound{tag: "a", delay: 5 * time.Second}
+	fast := &scriptedOutbound{tag: "b"}
+	w := newHedgeTestWeighted(slow, fast)
+	w.UpdateAvailability(1, false)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		conn, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+		if conn != nil {
+			conn.Close()
+		}
+		done <- err
+	}()
+	time.Sleep(hedgeDelay + 100*time.Millisecond)
+	w.UpdateAvailability(1, true)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(400 * time.Millisecond):
+		t.Fatal("newly available network was ignored after hedge timer")
+	}
+}
+func TestNetworkLossCancelsPendingDial(t *testing.T) {
+	slow := &scriptedOutbound{tag: "a", delay: 5 * time.Second}
+	fast := &scriptedOutbound{tag: "b"}
+	w := newPriorityTestWeighted(slow, fast)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		conn, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+		if conn != nil {
+			conn.Close()
+		}
+		done <- err
+	}()
+	deadline := time.Now().Add(time.Second)
+	for slow.calls.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	w.UpdateAvailability(0, false)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(300 * time.Millisecond):
+		t.Fatal("lost network dial continued instead of failing over")
+	}
+}
+
+func TestNetworkEpochDoesNotCancelOtherSlot(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{tag: "a"}, &scriptedOutbound{tag: "b"})
+	oldA := w.memberNetworkContext(0)
+	oldB := w.memberNetworkContext(1)
+	w.UpdateAvailability(0, false)
+	if oldA.Err() == nil {
+		t.Fatal("lost network context survived")
+	}
+	if oldB.Err() != nil {
+		t.Fatal("healthy other slot was canceled")
+	}
+	w.UpdateAvailability(0, true)
+	newA := w.memberNetworkContext(0)
+	if newA == oldA || newA.Err() != nil {
+		t.Fatal("recovered network inherited old cancellation")
+	}
+	w.UpdateAvailability(0, false)
+	if newA.Err() == nil {
+		t.Fatal("second loss did not cancel recovered network")
+	}
+	if oldB.Err() != nil {
+		t.Fatal("second loss canceled other slot")
+	}
+}
+
+func TestOpeningStreamDoesNotConfirmNetworkRecovery(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if w.health[0].consecutiveFailures.Load() != 2 || w.health[0].consecutiveSuccesses.Load() != 0 {
+		t.Fatal("opening a stream without receiving a response falsely confirmed network health")
+	}
+}
+
+type responseOutbound struct {
+	scriptedOutbound
+	peer chan net.Conn
+}
+
+func (f *responseOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	client, server := net.Pipe()
+	f.peer <- server
+	return client, nil
+}
+
+func TestTCPResponseConfirmsHealthOnce(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	outbound := &responseOutbound{peer: make(chan net.Conn, 1)}
+	w.members[0].outbound = outbound
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	peer := <-outbound.peer
+	defer peer.Close()
+	conn.SetReadDeadline(time.Now().Add(time.Second))
+	go func() { peer.Write([]byte("ok")) }()
+	for i := 0; i < 2; i++ {
+		if _, err = conn.Read(make([]byte, 1)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if w.health[0].consecutiveFailures.Load() != 0 || w.health[0].consecutiveSuccesses.Load() != 1 {
+		t.Fatal("real response must credit health exactly once")
+	}
+}
+
+func TestUDPResponseConfirmsHealthOnceAcrossReadAPIs(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.ListenPacket(context.Background(), M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if w.health[0].consecutiveFailures.Load() != 2 {
+		t.Fatal("UDP allocation falsely credited health")
+	}
+	peer, err := net.Dial("udp", conn.LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	conn.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err = peer.Write([]byte("one")); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = conn.ReadFrom(make([]byte, 16)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = peer.Write([]byte("two")); err != nil {
+		t.Fatal(err)
+	}
+	buffer := buf.NewSize(16)
+	defer buffer.Release()
+	if _, err = conn.(N.NetPacketConn).ReadPacket(buffer); err != nil {
+		t.Fatal(err)
+	}
+	if w.health[0].consecutiveFailures.Load() != 0 || w.health[0].consecutiveSuccesses.Load() != 1 {
+		t.Fatal("UDP response must credit health exactly once across read APIs")
+	}
+}

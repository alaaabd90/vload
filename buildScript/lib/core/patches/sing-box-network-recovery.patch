+func TestOpeningStreamDoesNotConfirmNetworkRecovery(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if w.health[0].consecutiveFailures.Load() != 2 || w.health[0].consecutiveSuccesses.Load() != 0 {
+		t.Fatal("opening a stream without receiving a response falsely confirmed network health")
+	}
+}
+
+type responseOutbound struct {
+	scriptedOutbound
+	peer chan net.Conn
+}
+
+func (f *responseOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	client, server := net.Pipe()
+	f.peer <- server
+	return client, nil
+}
+
+func TestTCPResponseConfirmsHealthOnce(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	outbound := &responseOutbound{peer: make(chan net.Conn, 1)}
+	w.members[0].outbound = outbound
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	peer := <-outbound.peer
+	defer peer.Close()
+	conn.SetReadDeadline(time.Now().Add(time.Second))
+	go func() { peer.Write([]byte("ok")) }()
+	for i := 0; i < 2; i++ {
+		if _, err = conn.Read(make([]byte, 1)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if w.health[0].consecutiveFailures.Load() != 0 || w.health[0].consecutiveSuccesses.Load() != 1 {
+		t.Fatal("real response must credit health exactly once")
+	}
+}
+
+func TestUDPResponseConfirmsHealthOnceAcrossReadAPIs(t *testing.T) {
+	w := newPriorityTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.health[0].consecutiveFailures.Store(2)
+	conn, err := w.ListenPacket(context.Background(), M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if w.health[0].consecutiveFailures.Load() != 2 {
+		t.Fatal("UDP allocation falsely credited health")
+	}
+	peer, err := net.Dial("udp", conn.LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	conn.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err = peer.Write([]byte("one")); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = conn.ReadFrom(make([]byte, 16)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = peer.Write([]byte("two")); err != nil {
+		t.Fatal(err)
+	}
+	buffer := buf.NewSize(16)
+	defer buffer.Release()
+	if _, err = conn.(N.NetPacketConn).ReadPacket(buffer); err != nil {
+		t.Fatal(err)
+	}
+	if w.health[0].consecutiveFailures.Load() != 0 || w.health[0].consecutiveSuccesses.Load() != 1 {
+		t.Fatal("UDP response must credit health exactly once across read APIs")
+	}
+}

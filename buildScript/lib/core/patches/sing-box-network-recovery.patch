+		t.Fatal("repeatedly losing member was still chosen as primary")
+	}
+}
+
+func TestRepeatedHedgeLossesNeverDisableBackup(t *testing.T) {
+	slow, fast := &scriptedOutbound{delay: 2 * time.Second}, &scriptedOutbound{}
+	w := newHedgeTestWeighted(slow, fast)
+	w.hedgeLossStreak = make([]atomic.Int32, 2)
+	w.hedgeSlowUntil = make([]atomic.Int64, 2)
+	for member := 0; member < 2; member++ {
+		for i := 0; i < hedgeLossStreakThreshold; i++ {
+			w.recordHedgeOutcome(member, false)
+		}
+	}
+	w.limiters[1].acquire()
+	defer w.limiters[1].release()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal("loss history disabled backup connection:", err)
+	}
+	c.Close()
+	if fast.calls.Load() != 1 {
+		t.Fatal("backup path was not tried")
+	}
+}
+
+func TestPeerSetupPressureDoesNotDisplaceResponsiveWebPath(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.responseStats(0).observe(5 * time.Millisecond)
+	w.responseStats(1).observe(50 * time.Millisecond)
+	w.priority = true
+	for i := 0; i < 30; i++ {
+		c, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("peer.example:6881"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer c.Close()
+	}
+	w.priority = false
+	c, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("web.example:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if w.lastPicked.Load() != 0 {
+		t.Fatal("peer setup pressure displaced the responsive web path")
+	}
+}
+
+func TestWebColdStartUsesWebPendingInsteadOfPeerHeadroom(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	for i := 0; i < 100; i++ {
+		w.limiters[0].acquire()
+	}
+	index, _, err := w.pickExceptForTraffic(-1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 0 {
+		t.Fatal("peer count displaced the first web attempt")
+	}
+	w.responseStats(0).pending.Store(2)
+	index, _, err = w.pickExceptForTraffic(-1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 1 {
+		t.Fatal("web setup pressure was not considered")
+	}
+}
+func TestPeerHedgeLossesDoNotDeprioritizeWeb(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.hedgeLossStreak = make([]atomic.Int32, 2)
+	w.hedgeSlowUntil = make([]atomic.Int64, 2)
+	w.peerHedgeLossStreak = make([]atomic.Int32, 2)
+	w.peerHedgeSlowUntil = make([]atomic.Int64, 2)
+	for i := 0; i < hedgeLossStreakThreshold; i++ {
+		w.recordHedgeOutcomeForTraffic(0, false, false)
+	}
+	if !w.hedgeDeprioritizedForTraffic(0, false) {
+		t.Fatal("peer losses not recorded")
+	}
+	if w.hedgeDeprioritizedForTraffic(0, true) {
+		t.Fatal("peer losses penalized web pool")
+	}
+	w.responseStatsForTraffic(0, false).observe(time.Second)
+	w.UpdateAvailability(0, false)
+	w.UpdateAvailability(0, true)
+	if _, known := w.responseStatsForTraffic(0, false).score(time.Now()); known {
+		t.Fatal("old peer latency survived replacement")
+	}
+}
+
+func TestOneSlowResponseDoesNotOverwriteWebPathHistory(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.responseStats(0).observe(100 * time.Millisecond)
+	w.responseStats(1).observe(500 * time.Millisecond)
+	w.responseStats(0).observe(2 * time.Second)
+	index, _, err := w.pickExceptForTraffic(-1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 0 {
+		t.Fatal("one delayed destination response displaced the normally faster web path")
+	}
+	for i := 0; i < 8; i++ {
+		w.responseStats(0).observe(2 * time.Second)
+	}
+	index, _, err = w.pickExceptForTraffic(-1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 1 {
+		t.Fatal("sustained slow responses failed to change the preferred path")
+	}
+}
+
+// Browser speculative connections can stay open without sending any data.
+// They must not accumulate first-response pressure on an otherwise fast path.
+func TestIdlePreconnectionsDoNotDisplaceResponsiveWebPath(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.members[0].outbound = &latencyOutbound{responseDelay: time.Millisecond}
+	w.responseStats(0).observe(10 * time.Millisecond)
+	w.responseStats(1).observe(100 * time.Millisecond)
+	w.priority = true
+	for i := 0; i < 16; i++ {
+		conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+	}
+	w.priority = false
+	index, _, err := w.pick()
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 0 {
+		t.Fatal("idle preconnections displaced responsive web path")
+	}
+	if pending := w.responseStats(0).pending.Load(); pending != 0 {
+		t.Fatalf("idle preconnections retain %d pending responses", pending)
+	}
+}
+
+func TestResponseTrackerCountsDialAndRequestButNotIdle(t *testing.T) {
+	stats := new(responseStats)
+	tracker := newResponseTracker(stats)
+	if stats.pending.Load() != 1 {
+		t.Fatal("dial not counted")
+	}
+	tracker.ready()
+	tracker.ready()
+	if stats.pending.Load() != 0 {
+		t.Fatal("idle socket counted")
+	}
+	tracker.write()
+	tracker.write()
+	tracker.ready()
+	if stats.pending.Load() != 1 {
+		t.Fatal("request must count exactly once")
+	}
+	tracker.response()
+	tracker.close()
+	tracker.write()
+	tracker.ready()
+	if stats.pending.Load() != 0 {
+		t.Fatal("completed request leaked pressure")
+	}
+	for i := 0; i < 100; i++ {
+		tracker := newResponseTracker(stats)
+		var done sync.WaitGroup
+		done.Add(4)
+		go func() { defer done.Done(); tracker.ready() }()
+		go func() { defer done.Done(); tracker.write() }()
+		go func() { defer done.Done(); tracker.response() }()
+		go func() { defer done.Done(); tracker.close() }()
+		done.Wait()
+	}
+	if stats.pending.Load() != 0 {
+		t.Fatal("concurrent lifecycle leaked pressure")
+	}
+}

diff --git a/protocol/group/weighted_latency.go b/protocol/group/weighted_latency.go
new file mode 100644
index 000000000..ea4025ce9
--- /dev/null
+++ b/protocol/group/weighted_latency.go
@@ -0,0 +1,139 @@
+package group
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// Active browser connections can remain idle for minutes. Only connections
+// awaiting their first response contribute to setup pressure on a path.
+type responseStats struct {
+	delay      atomic.Int64
+	observedAt atomic.Int64
+	pending    atomic.Int64
+}
+
+func (s *responseStats) observe(sample time.Duration) {
+	if sample < time.Millisecond {
+		sample = time.Millisecond
+	}
+	for {
+		old := s.delay.Load()
+		next := int64(sample)
+		// A response includes destination DNS/server delay as well as the
+		// network. Smooth both directions so one delayed destination does not
+		// replace a path's history. Pending setup pressure reacts separately.
+		if old > 0 {
+			next = old + (next-old)/8
+		}
+		if s.delay.CompareAndSwap(old, next) {
+			break
+		}
+	}
+	s.observedAt.Store(time.Now().UnixNano())
+}
+
+func (s *responseStats) score(now time.Time) (float64, bool) {
+	delay := s.delay.Load()
+	if delay == 0 || now.Sub(time.Unix(0, s.observedAt.Load())) > time.Minute {
+		return 0, false
+	}
+	pending := s.pending.Load()
+	if pending < 0 {
+		pending = 0
+	}
+	return float64(delay) * float64(pending+1), true
+}
+
+func (w *Weighted) ensureResponseStatsLocked() {
+	if len(w.responses) == len(w.health) {
+		return
+	}
+	w.responses = make([]*responseStats, len(w.health))
+	w.peerResponses = make([]*responseStats, len(w.health))
+	for i := range w.responses {
+		w.responses[i] = new(responseStats)
+		w.peerResponses[i] = new(responseStats)
+	}
+}
+
+func (w *Weighted) responseStats(index int) *responseStats {
+	return w.responseStatsForTraffic(index, true)
+}
+func (w *Weighted) responseStatsForTraffic(index int, web bool) *responseStats {
+	w.pickMu.Lock()
+	defer w.pickMu.Unlock()
+	w.ensureResponseStatsLocked()
+	if web {
+		return w.responses[index]
+	}
+	return w.peerResponses[index]
+}
+
+type responseTracker struct {
+	stats    *responseStats
+	created  time.Time
+	mu       sync.Mutex
+	written  time.Time
+	pending  bool
+	finished atomic.Bool
+}
+
+func newResponseTracker(stats *responseStats) *responseTracker {
+	stats.pending.Add(1)
+	return &responseTracker{stats: stats, created: time.Now(), pending: true}
+}
+
+// A completed dial may be a browser preconnection with no request yet.
+// Count dialing and actual first-response waits, but not application idle time.
+func (t *responseTracker) ready() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.finished.Load() && t.written.IsZero() && t.pending {
+		t.stats.pending.Add(-1)
+		t.pending = false
+	}
+}
+
+func (t *responseTracker) write() {
+	if t.finished.Load() {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.finished.Load() || !t.written.IsZero() {
+		return
+	}
+	t.written = time.Now()
+	if !t.pending {
+		t.stats.pending.Add(1)
+		t.pending = true
+	}
+}
+
+func (t *responseTracker) response() { t.finish(true) }
+func (t *responseTracker) close()    { t.finish(false) }
+
+func (t *responseTracker) finish(observe bool) {
+	if t.finished.Load() {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.finished.Load() {
+		return
+	}
+	t.finished.Store(true)
+	if t.pending {
+		t.stats.pending.Add(-1)
+		t.pending = false
+	}
+	if observe {
+		start := t.created
+		if !t.written.IsZero() {
+			start = t.written
+		}
+		t.stats.observe(time.Since(start))
+	}
+}

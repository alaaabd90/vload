+package group
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type latencyOutbound struct {
+	scriptedOutbound
+	responseDelay time.Duration
+}
+
+func TestResponsePressureStillUsesSecondNetwork(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.responseStats(0).observe(10 * time.Millisecond)
+	w.responseStats(1).observe(40 * time.Millisecond)
+	w.responseStats(0).pending.Store(5)
+	index, _, err := w.pick()
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 1 {
+		t.Fatal("pending responses on faster path did not shift work to second network")
+	}
+	w.priority = true
+	index, _, err = w.pick()
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.release(index)
+	if index != 0 {
+		t.Fatal("response scoring changed strict priority semantics")
+	}
+}
+
+func TestResponseTrackerExcludesApplicationIdleTime(t *testing.T) {
+	stats := new(responseStats)
+	tracker := newResponseTracker(stats)
+	tracker.created = time.Now().Add(-time.Minute)
+	tracker.write()
+	tracker.response()
+	tracker.close()
+	if stats.pending.Load() != 0 {
+		t.Fatal("pending count leaked or was released twice")
+	}
+	if stats.delay.Load() >= int64(time.Second) {
+		t.Fatal("application idle time became a network delay sample")
+	}
+}
+
+func TestResponseTrackerConcurrentCloseAndResponse(t *testing.T) {
+	stats := new(responseStats)
+	for i := 0; i < 100; i++ {
+		tracker := newResponseTracker(stats)
+		var done sync.WaitGroup
+		done.Add(3)
+		go func() { defer done.Done(); tracker.write() }()
+		go func() { defer done.Done(); tracker.response() }()
+		go func() { defer done.Done(); tracker.close() }()
+		done.Wait()
+	}
+	if stats.pending.Load() != 0 {
+		t.Fatal("concurrent close/response corrupted pending count")
+	}
+}
+
+func TestNetworkReplacementDiscardsOldLatency(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.responseStats(0).observe(time.Second)
+	w.responseStats(1).observe(10 * time.Millisecond)
+	w.UpdateAvailability(0, false)
+	w.UpdateAvailability(0, true)
+	if _, known := w.responseStats(0).score(time.Now()); known {
+		t.Fatal("replacement inherited old network delay")
+	}
+	if _, known := w.responseStats(1).score(time.Now()); !known {
+		t.Fatal("unaffected network lost its delay sample")
+	}
+	if _, known := w.responseStats(1).score(time.Now().Add(2 * time.Minute)); known {
+		t.Fatal("stale delay was trusted indefinitely")
+	}
+}
+
+func (f *latencyOutbound) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	f.calls.Add(1)
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		var request [1]byte
+		if _, err := io.ReadFull(server, request[:]); err != nil {
+			return
+		}
+		select {
+		case <-time.After(f.responseDelay):
+		case <-ctx.Done():
+			return
+		}
+		server.Write([]byte{1})
+	}()
+	return client, nil
+}
+
+func TestIdleFastConnectionDoesNotPushBrowsingToSlowNetwork(t *testing.T) {
+	fast := &latencyOutbound{responseDelay: 5 * time.Millisecond}
+	slow := &latencyOutbound{responseDelay: 80 * time.Millisecond}
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.members[0].outbound = fast
+	w.members[1].outbound = slow
+	// Learn one real response on each network. Keep the fast connection
+	// allocated, like a browser's established idle connection.
+	w.priority = true
+	first, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	first.SetDeadline(time.Now().Add(time.Second))
+	if _, err = first.Write([]byte{1}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = first.Read(make([]byte, 1)); err != nil {
+		t.Fatal(err)
+	}
+	w.priority = false
+	// Occupy one response slot briefly so the still-unmeasured second path
+	// gets a real sample instead of assuming that it is fast.
+	w.priority = true
+	pending, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pending.Close()
+	w.priority = false
+	second, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	second.SetDeadline(time.Now().Add(time.Second))
+	if _, err = second.Write([]byte{1}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = second.Read(make([]byte, 1)); err != nil {
+		t.Fatal(err)
+	}
+	second.Close()
+	pending.Close()
+	next, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer next.Close()
+	if w.lastPicked.Load() != 0 {
+		t.Fatal("idle fast connection caused browsing to select the proven slow network")
+	}
+}
+
+func TestKnownResponsivePathIsPreferredOverUnmeasuredIdlePath(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	w.members[0].outbound = &latencyOutbound{responseDelay: 5 * time.Millisecond}
+	w.priority = true
+	first, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	first.SetDeadline(time.Now().Add(time.Second))
+	first.Write([]byte{1})
+	if _, err = first.Read(make([]byte, 1)); err != nil {
+		t.Fatal(err)
+	}
+	w.priority = false
+	next, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer next.Close()
+	if w.lastPicked.Load() != 0 {
+		t.Fatal("unmeasured idle path displaced a proven responsive path")
+	}
+}
+
+func TestPendingResponseCountReleasedAfterHedgeAndDialFailure(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{delay: time.Second}, &scriptedOutbound{})
+	w.limiters[1].acquire()
+	conn, err := w.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	deadline := time.Now().Add(time.Second)
+	for (w.responseStats(0).pending.Load() != 0 || w.responseStats(1).pending.Load() != 0) && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if w.responseStats(0).pending.Load() != 0 || w.responseStats(1).pending.Load() != 0 {
+		t.Fatal("canceled hedge leaked setup pressure")
+	}
+	failed := newHedgeTestWeighted(&scriptedOutbound{err: errors.New("dial failed")}, &scriptedOutbound{err: errors.New("dial failed")})
+	if conn, err = failed.DialContext(context.Background(), "tcp", M.ParseSocksaddr("example.com:443")); err == nil {
+		conn.Close()
+		t.Fatal("expected failure")
+	}
+	if failed.responseStats(0).pending.Load() != 0 || failed.responseStats(1).pending.Load() != 0 {
+		t.Fatal("failed dial leaked setup pressure")
+	}
+}
+
+func TestLateOldNetworkResponseDoesNotRestoreLatency(t *testing.T) {
+	w := newHedgeTestWeighted(&scriptedOutbound{}, &scriptedOutbound{})
+	old := newResponseTracker(w.responseStats(0))
+	w.UpdateAvailability(0, false)
+	w.UpdateAvailability(0, true)
+	old.write()
+	old.response()
+	if _, known := w.responseStats(0).score(time.Now()); known {
+		t.Fatal("late response contaminated replacement network latency")
+	}
+}
+
+func TestRepeatedHedgeLossesPreferResponsiveMember(t *testing.T) {
+	slow, fast := &scriptedOutbound{delay: 2 * time.Second}, &scriptedOutbound{}
+	w := newHedgeTestWeighted(slow, fast)
+	w.hedgeLossStreak = make([]atomic.Int32, 2)
+	w.hedgeSlowUntil = make([]atomic.Int64, 2)
+	for i := 0; i < hedgeLossStreakThreshold; i++ {
+		w.recordHedgeOutcome(0, false)
+	}
+	w.limiters[1].acquire()
+	defer w.limiters[1].release()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal("known slow member blocked responsive member:", err)
+	}
+	defer c.Close()
+	if slow.calls.Load() != 0 {
+		t.Fatal("repeatedly losing member was still chosen as primary")
+	}
+}
+
+func TestRepeatedHedgeLossesNeverDisableBackup(t *testing.T) {
+	slow, fast := &scriptedOutbound{delay: 2 * time.Second}, &scriptedOutbound{}
+	w := newHedgeTestWeighted(slow, fast)
+	w.hedgeLossStreak = make([]atomic.Int32, 2)
+	w.hedgeSlowUntil = make([]atomic.Int64, 2)
+	for member := 0; member < 2; member++ {
+		for i := 0; i < hedgeLossStreakThreshold; i++ {
+			w.recordHedgeOutcome(member, false)
+		}
+	}
+	w.limiters[1].acquire()
+	defer w.limiters[1].release()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c, err := w.DialContext(ctx, "tcp", M.ParseSocksaddr("example.com:443"))
+	if err != nil {
+		t.Fatal("loss history disabled backup connection:", err)
+	}
+	c.Close()
+	if fast.calls.Load() != 1 {
+		t.Fatal("backup path was not tried")
+	}
+}

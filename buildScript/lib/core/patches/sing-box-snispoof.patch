new file mode 100644
index 000000000..b5fff1408
--- /dev/null
+++ b/common/tls/snispoof_test.go
@@ -0,0 +1,167 @@
+package tls
+
+import (
+	"context"
+	ctls "crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type testSNIDialer struct {
+	address string
+	calls   sync.Map
+}
+
+func (d *testSNIDialer) DialContext(ctx context.Context, network string, dest M.Socksaddr) (net.Conn, error) {
+	count, _ := d.calls.LoadOrStore(dest.AddrString(), new(atomic.Int32))
+	count.(*atomic.Int32).Add(1)
+	if dest.AddrString() == "192.0.2.1" {
+		return nil, errors.New("simulated unavailable physical path")
+	}
+	return (&net.Dialer{}).DialContext(ctx, "tcp", d.address)
+}
+func (d *testSNIDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("UDP not supported")
+}
+
+func testServer(t *testing.T, ech bool) (*httptest.Server, string) {
+	t.Helper()
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	var configPEM string
+	if ech {
+		var keys string
+		var err error
+		configPEM, keys, err = ECHKeygenDefault("example.com")
+		if err != nil {
+			t.Fatal(err)
+		}
+		parsed, err := parseECHKeys([]byte(keys))
+		if err != nil {
+			t.Fatal(err)
+		}
+		server.TLS = &ctls.Config{EncryptedClientHelloKeys: parsed}
+	}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server, configPEM
+}
+func testConfig(t *testing.T, server *httptest.Server, echPEM, strategy string) *sniConfig {
+	t.Helper()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	opts := option.OutboundTLSOptions{Enabled: true, ServerName: "example.com", Certificate: []string{string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}))}, SNISpoof: &option.SNISpoofOptions{Strategy: strategy, FragmentSize: 128, AttemptTimeoutMS: 1000, TotalTimeoutMS: 5000, MaxCandidates: 2, RetryAfterSeconds: 10, CandidateIPs: []string{"127.0.0.1"}}}
+	if echPEM != "" {
+		opts.SNISpoof.RequireECH = true
+		opts.ECH = &option.OutboundECHOptions{Enabled: true, Config: []string{echPEM}}
+	}
+	config, err := NewClientWithOptions(ClientOptions{Context: context.Background(), Options: opts, ServerAddress: "example.com"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return config.(*sniConfig)
+}
+func TestSNISpoofRealTLSAndECH(t *testing.T) {
+	for _, ech := range []bool{false, true} {
+		server, echPEM := testServer(t, ech)
+		for _, strategy := range []string{"none", "sni", "record", "chunks", "auto"} {
+			t.Run(strategy+map[bool]string{true: "-ECH", false: ""}[ech], func(t *testing.T) {
+				config := testConfig(t, server, echPEM, strategy)
+				raw := &testSNIDialer{address: server.Listener.Addr().String()}
+				conn, err := NewDialer(raw, config).DialTLSContext(context.Background(), M.ParseSocksaddr("192.0.2.1:443"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conn.Close()
+				if conn.ConnectionState().ECHAccepted != ech {
+					t.Fatal("incorrect ECH state")
+				}
+				if len(conn.ConnectionState().VerifiedChains) == 0 {
+					t.Fatal("certificate not verified")
+				}
+				_, err = io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+				if err != nil {
+					t.Fatal(err)
+				}
+				response, err := io.ReadAll(conn)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !strings.Contains(string(response), "204 No Content") {
+					t.Fatalf("request failed: %s", response)
+				}
+			})
+		}
+	}
+}
+func TestSNISpoofRejectsUnacceptedECH(t *testing.T) {
+	server, _ := testServer(t, false)
+	config := testConfig(t, server, "", "none")
+	config.settings.RequireECH = true // Exercise the explicit acceptance guard independently.
+	_, err := NewDialer(&testSNIDialer{address: server.Listener.Addr().String()}, config).DialTLSContext(context.Background(), M.ParseSocksaddr("127.0.0.1:443"))
+	if err == nil || !strings.Contains(err.Error(), "ECH was not accepted") {
+		t.Fatalf("expected fail closed, got %v", err)
+	}
+}
+func TestSNISpoofCooldownAndNetworkReset(t *testing.T) {
+	server, _ := testServer(t, false)
+	config := testConfig(t, server, "", "none")
+	config.settings.CandidateIPs = nil
+	raw := &testSNIDialer{address: server.Listener.Addr().String()}
+	dialer := NewDialer(raw, config)
+	for i := 0; i < 2; i++ {
+		_, _ = dialer.DialTLSContext(context.Background(), M.ParseSocksaddr("192.0.2.1:443"))
+	}
+	count, _ := raw.calls.Load("192.0.2.1")
+	if count.(*atomic.Int32).Load() != 1 {
+		t.Fatal("cooldown ignored")
+	}
+	ResetSNISpoof(config)
+	_, _ = dialer.DialTLSContext(context.Background(), M.ParseSocksaddr("192.0.2.1:443"))
+	if count.(*atomic.Int32).Load() != 2 {
+		t.Fatal("replacement network was quarantined")
+	}
+}
+func TestSNICandidatesBoundedAndPrioritized(t *testing.T) {
+	ips := SNICandidates("192.0.2.1", option.SNISpoofOptions{CandidateIPs: []string{"192.0.2.2", "2001:db8::/120"}, DiscoverCloudflare: true, MaxCandidates: 8})
+	if len(ips) != 8 || ips[0] != "192.0.2.2" {
+		t.Fatal(ips)
+	}
+	seen := map[string]bool{}
+	for _, ip := range ips {
+		if seen[ip] {
+			t.Fatal("duplicate")
+		}
+		seen[ip] = true
+	}
+}
+func TestSNISpoofDisabledUsesOriginalDialer(t *testing.T) {
+	server, _ := testServer(t, false)
+	config := testConfig(t, server, "", "none")
+	if _, ok := NewDialer(&testSNIDialer{}, config.Config).(*defaultDialer); !ok {
+		t.Fatal("disabled profile changed dialer")
+	}
+}
+func TestSNISpoofCanceledParent(t *testing.T) {
+	server, _ := testServer(t, false)
+	config := testConfig(t, server, "", "none")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	start := time.Now()
+	_, err := NewDialer(&testSNIDialer{address: server.Listener.Addr().String()}, config).DialTLSContext(ctx, M.ParseSocksaddr("127.0.0.1:443"))
+	if err == nil || time.Since(start) > time.Second {
+		t.Fatal("cancellation ignored")
+	}
+}

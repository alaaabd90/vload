+package option
+
+// SNISpoofOptions is an opt-in, rootless TLS connection policy. It never
+// replaces the verified server identity. Optional fake packets use rootless TCP.
+type SNISpoofOptions struct {
+	FakeEnabled        bool     `json:"fake_enabled,omitempty"`
+	FakeSNI            string   `json:"fake_sni,omitempty"`
+	FakeTTL            int      `json:"fake_ttl,omitempty"`
+	FakeAutoTTL        bool     `json:"fake_auto_ttl,omitempty"`
+	FakeDelayMS        int      `json:"fake_delay_ms,omitempty"`
+	Strategy           string   `json:"strategy,omitempty"`
+	FragmentSize       int      `json:"fragment_size,omitempty"`
+	DelayMS            int      `json:"delay_ms,omitempty"`
+	RequireECH         bool     `json:"require_ech,omitempty"`
+	CandidateIPs       []string `json:"candidate_ips,omitempty"`
+	DiscoverCloudflare bool     `json:"discover_cloudflare,omitempty"`
+	MaxCandidates      int      `json:"max_candidates,omitempty"`
+	AttemptTimeoutMS   int      `json:"attempt_timeout_ms,omitempty"`
+	TotalTimeoutMS     int      `json:"total_timeout_ms,omitempty"`
+	RetryAfterSeconds  int      `json:"retry_after_seconds,omitempty"`
+	Diagnostics        bool     `json:"diagnostics,omitempty"`
+}

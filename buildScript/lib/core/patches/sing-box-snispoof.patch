+package tls
+
+import (
+	"context"
+	"encoding/pem"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func TestSNISpoofAutomaticECHUsesBoundDialerAndCachesKeys(t *testing.T) {
+	server, echPEM := testServer(t, true)
+	block, _ := pem.Decode([]byte(echPEM))
+	opts := option.OutboundTLSOptions{Enabled: true, ServerName: "example.com", Certificate: []string{string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}))}, ECH: &option.OutboundECHOptions{Enabled: true}, SNISpoof: &option.SNISpoofOptions{Strategy: "sni", RequireECH: true, MaxCandidates: 1}}
+	config, err := NewClientWithOptions(ClientOptions{Context: context.Background(), Options: opts, ServerAddress: "example.com"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := &testSNIDialer{address: server.Listener.Addr().String()}
+	var calls atomic.Int32
+	c := config.(*sniConfig)
+	if !c.fetchECH {
+		t.Fatal("dynamic ECH not bootstrapped")
+	}
+	c.echFetch = func(ctx context.Context, dialer N.Dialer, name string) ([]byte, time.Duration, error) {
+		calls.Add(1)
+		if dialer != raw || name != "example.com" {
+			t.Error("wrong physical dialer or name")
+		}
+		return block.Bytes, time.Hour, nil
+	}
+	d := NewDialer(raw, c)
+	for i := 0; i < 2; i++ {
+		conn, err := d.DialTLSContext(context.Background(), M.ParseSocksaddr("127.0.0.1:443"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !conn.ConnectionState().ECHAccepted {
+			t.Fatal("ECH not accepted")
+		}
+		conn.Close()
+	}
+	if calls.Load() != 1 {
+		t.Fatal("ECH config not cached")
+	}
+}
+
+func TestSNISpoofECHResponseValidation(t *testing.T) {
+	query := new(mdns.Msg).SetQuestion("example.com.", mdns.TypeHTTPS)
+	response := new(mdns.Msg).SetReply(query)
+	response.Answer = []mdns.RR{&mdns.HTTPS{SVCB: mdns.SVCB{Hdr: mdns.RR_Header{Name: "example.com.", Rrtype: mdns.TypeHTTPS, Class: mdns.ClassINET, Ttl: 120}, Priority: 1, Target: ".", Value: []mdns.SVCBKeyValue{&mdns.SVCBECHConfig{ECH: []byte{0, 1, 42}}}}}}
+	body, err := response.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	config, ttl, err := parseSNIECHResponse(body, query)
+	if err != nil || len(config) != 3 || ttl != 120*time.Second {
+		t.Fatalf("%x %v %v", config, ttl, err)
+	}
+	response.Id++
+	body, _ = response.Pack()
+	if _, _, err := parseSNIECHResponse(body, query); err == nil {
+		t.Fatal("accepted mismatched DNS response")
+	}
+	response.SetReply(query)
+	response.Answer = nil
+	body, _ = response.Pack()
+	if _, _, err := parseSNIECHResponse(body, query); err == nil {
+		t.Fatal("missing ECH treated as success")
+	}
+}

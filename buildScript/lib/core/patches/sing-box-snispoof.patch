@@ -0,0 +1,31 @@
+package snispoof
+
+import (
+	"io"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type countedBody struct {
+	io.Reader
+	closed atomic.Int32
+}
+
+func (b *countedBody) Close() error { b.closed.Add(1); return nil }
+func TestLateResponseReadSetupAndClose(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		body := &countedBody{Reader: strings.NewReader("ok")}
+		reader := NewLateReader(nil)
+		var wg sync.WaitGroup
+		wg.Add(3)
+		go func() { defer wg.Done(); reader.Setup(body, nil) }()
+		go func() { defer wg.Done(); io.ReadAll(reader) }()
+		go func() { defer wg.Done(); reader.Close() }()
+		wg.Wait()
+		if body.closed.Load() != 1 {
+			t.Fatal("late response leaked or double closed")
+		}
+	}
+}

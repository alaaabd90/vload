diff --git a/common/snispoof/fake_test.go b/common/snispoof/fake_test.go
new file mode 100644
index 000000000..5c9ed6d4a
--- /dev/null
+++ b/common/snispoof/fake_test.go
@@ -0,0 +1,44 @@
+package snispoof
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"testing"
+)
+
+func TestFakeHelloIdentitySizeAndRandomness(t *testing.T) {
+	for _, size := range []int{256, 512, 1199, 1200} {
+		a, err := FakeHello("api.twitter.com", size)
+		if err != nil {
+			t.Fatal(err)
+		}
+		b, _ := FakeHello("api.twitter.com", size)
+		if len(a) != size || int(binary.BigEndian.Uint16(a[3:5])) != size-5 {
+			t.Fatal("incorrect record length")
+		}
+		pos, n := SNIRange(a)
+		if pos < 0 || string(a[pos:pos+n]) != "api.twitter.com" {
+			t.Fatal("incorrect decoy SNI")
+		}
+		if bytes.Equal(a, b) {
+			t.Fatal("decoy randomness reused")
+		}
+	}
+	for _, bad := range []string{"", "https://api.twitter.com", "a..com", "-a.com", "a.com/", "a\x00.com"} {
+		if _, err := FakeHello(bad, 512); err == nil {
+			t.Fatalf("accepted invalid hostname %q", bad)
+		}
+	}
+}
+
+func TestFakeModeNeverFallsBackOnUnsupportedConnection(t *testing.T) {
+	raw := new(captureConn)
+	conn := NewConnWithFake(context.Background(), raw, "sni", 128, 0, &FakeOptions{ServerName: "api.twitter.com", TTL: 8, DelayMS: 10})
+	if _, err := conn.Write(hello(t)); err == nil {
+		t.Fatal("missing raw socket must fail fake mode")
+	}
+	if raw.Len() != 0 {
+		t.Fatal("silently sent real hello after fake injection failure")
+	}
+}
diff --git a/common/snispoof/fragment.go b/common/snispoof/fragment.go
new file mode 100644
index 000000000..768777dc5
--- /dev/null
+++ b/common/snispoof/fragment.go
@@ -0,0 +1,252 @@
+// Package snispoof implements opt-in TLS fragmentation and rootless TCP decoys.
+package snispoof
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"time"
+)
+
+type fragmentConn struct {
+	net.Conn
+	ctx      context.Context
+	strategy string
+	size     int
+	delay    time.Duration
+	mu       sync.Mutex
+	pending  []byte
+	finished bool
+	closed   chan struct{}
+	once     sync.Once
+	fake     *FakeOptions
+	fakeSent bool
+}
+
+func NewConn(ctx context.Context, conn net.Conn, strategy string, size int, delay time.Duration) net.Conn {
+	if strategy == "none" {
+		return conn
+	}
+	return &fragmentConn{Conn: conn, ctx: ctx, strategy: strategy, size: size, delay: delay, closed: make(chan struct{})}
+}
+
+// NewConnWithFake keeps fake injection and fragmentation inside the same first-hello writer.
+func NewConnWithFake(ctx context.Context, conn net.Conn, strategy string, size int, delay time.Duration, fake *FakeOptions) net.Conn {
+	if fake == nil {
+		return NewConn(ctx, conn, strategy, size, delay)
+	}
+	return &fragmentConn{Conn: conn, ctx: ctx, strategy: strategy, size: size, delay: delay, closed: make(chan struct{}), fake: fake}
+}
+
+func (c *fragmentConn) Close() error {
+	c.once.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+
+func writeAll(w io.Writer, p []byte) error {
+	for len(p) > 0 {
+		n, err := w.Write(p)
+		if n < 0 || n > len(p) {
+			return io.ErrShortWrite
+		}
+		p = p[n:]
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+// Buffer partial records rather than mistaking an arbitrary Write boundary
+// for a complete ClientHello. Only pre-response handshake records are split.
+func (c *fragmentConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return c.Conn.Write(p)
+	}
+	c.pending = append(c.pending, p...)
+	for len(c.pending) >= 5 {
+		if c.pending[0] != 22 {
+			err := writeAll(c.Conn, c.pending)
+			c.pending = nil
+			c.finished = true
+			if err != nil {
+				return 0, err
+			}
+			return len(p), nil
+		}
+		length := 5 + int(binary.BigEndian.Uint16(c.pending[3:5]))
+		if length > 18437 {
+			return 0, fmt.Errorf("SNISpoof: invalid TLS record length")
+		}
+		if len(c.pending) < length {
+			break
+		}
+		pieces := SplitRecord(c.pending[:length], c.strategy, c.size)
+		if c.fake != nil && !c.fakeSent {
+			var wire []byte
+			for _, piece := range pieces {
+				wire = append(wire, piece...)
+			}
+			consumed, err := SendFakePrefix(c.ctx, c.Conn, wire, *c.fake)
+			if err != nil {
+				return 0, fmt.Errorf("SNISpoof fake injection: %w", err)
+			}
+			c.fakeSent = true
+			for len(pieces) > 0 && consumed >= len(pieces[0]) {
+				consumed -= len(pieces[0])
+				pieces = pieces[1:]
+			}
+			if len(pieces) > 0 {
+				pieces[0] = pieces[0][consumed:]
+			}
+		}
+		for i, piece := range pieces {
+			if i > 0 && c.delay > 0 {
+				timer := time.NewTimer(c.delay)
+				select {
+				case <-timer.C:
+				case <-c.ctx.Done():
+					timer.Stop()
+					return 0, c.ctx.Err()
+				case <-c.closed:
+					timer.Stop()
+					return 0, net.ErrClosed
+				}
+			}
+			if err := writeAll(c.Conn, piece); err != nil {
+				return 0, err
+			}
+		}
+		c.pending = c.pending[length:]
+	}
+	return len(p), nil
+}
+
+func (c *fragmentConn) Read(p []byte) (int, error) {
+	c.mu.Lock()
+	// A peer response ends fragmentation; subsequent encrypted TLS records
+	// and application data follow the original connection unchanged.
+	c.finished = true
+	if len(c.pending) > 0 {
+		c.mu.Unlock()
+		return 0, io.ErrUnexpectedEOF
+	}
+	c.mu.Unlock()
+	return c.Conn.Read(p)
+}
+
+func SplitRecord(record []byte, strategy string, size int) [][]byte {
+	if size < 1 {
+		size = 64
+	}
+	if len(record) < 6 || record[0] != 22 {
+		return [][]byte{record}
+	}
+	if strategy == "none" {
+		return [][]byte{record}
+	}
+	if strategy == "sni" {
+		offset, length := SNIRange(record)
+		if length > 1 {
+			point := offset + length/2
+			return [][]byte{record[:point], record[point:]}
+		}
+		point := len(record) / 2
+		return [][]byte{record[:point], record[point:]}
+	}
+	var out [][]byte
+	if strategy == "record" {
+		for data := record[5:]; len(data) > 0; {
+			n := min(size, len(data))
+			part := make([]byte, 5+n)
+			copy(part, record[:5])
+			binary.BigEndian.PutUint16(part[3:5], uint16(n))
+			copy(part[5:], data[:n])
+			out = append(out, part)
+			data = data[n:]
+		}
+	} else {
+		for len(record) > 0 {
+			n := min(size, len(record))
+			out = append(out, record[:n])
+			record = record[n:]
+		}
+	}
+	return out
+}
+
+// Parse the actual ClientHello structure; never search random/cipher bytes
+// for a sequence that merely resembles an SNI extension.
+func SNIRange(p []byte) (int, int) {
+	if len(p) < 44 || p[0] != 22 || p[5] != 1 {
+		return -1, 0
+	}
+	end := 5 + int(binary.BigEndian.Uint16(p[3:5]))
+	if end > len(p) {
+		return -1, 0
+	}
+	handshakeEnd := 9 + (int(p[6]) << 16) + (int(p[7]) << 8) + int(p[8])
+	if handshakeEnd > end {
+		return -1, 0
+	}
+	pos := 43
+	skip := func(n int) bool {
+		if n < 0 || pos+n > end {
+			return false
+		}
+		pos += n
+		return true
+	}
+	if !skip(1+int(p[pos])) || pos+2 > end {
+		return -1, 0
+	}
+	n := int(binary.BigEndian.Uint16(p[pos : pos+2]))
+	if !skip(2+n) || pos >= end {
+		return -1, 0
+	}
+	if !skip(1+int(p[pos])) || pos+2 > end {
+		return -1, 0
+	}
+	extEnd := pos + 2 + int(binary.BigEndian.Uint16(p[pos:pos+2]))
+	pos += 2
+	if extEnd > end {
+		return -1, 0
+	}
+	for pos+4 <= extEnd {
+		typ := binary.BigEndian.Uint16(p[pos : pos+2])
+		n := int(binary.BigEndian.Uint16(p[pos+2 : pos+4]))
+		pos += 4
+		if pos+n > extEnd {
+			return -1, 0
+		}
+		if typ == 0 && n >= 5 {
+			listEnd := pos + 2 + int(binary.BigEndian.Uint16(p[pos:pos+2]))
+			q := pos + 2
+			if listEnd > pos+n {
+				return -1, 0
+			}
+			for q+3 <= listEnd {
+				kind := p[q]
+				size := int(binary.BigEndian.Uint16(p[q+1 : q+3]))
+				q += 3
+				if q+size > listEnd {
+					return -1, 0
+				}
+				if kind == 0 {
+					return q, size
+				}
+				q += size
+			}
+		}
+		pos += n
+	}
+	return -1, 0
+}
diff --git a/common/snispoof/fragment_test.go b/common/snispoof/fragment_test.go
new file mode 100644
index 000000000..d5fcb5330
--- /dev/null
+++ b/common/snispoof/fragment_test.go
@@ -0,0 +1,118 @@
+package snispoof
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+type captureConn struct {
+	bytes.Buffer
+	short bool
+}
+
+func (c *captureConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (c *captureConn) Write(p []byte) (int, error) {
+	if c.short && len(p) > 3 {
+		p = p[:3]
+	}
+	return c.Buffer.Write(p)
+}
+func (c *captureConn) Close() error                     { return nil }
+func (c *captureConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *captureConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *captureConn) SetDeadline(time.Time) error      { return nil }
+func (c *captureConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *captureConn) SetWriteDeadline(time.Time) error { return nil }
+
+func hello(t *testing.T) []byte {
+	t.Helper()
+	c := new(captureConn)
+	client := tls.Client(c, &tls.Config{ServerName: "real.example.test"})
+	_ = client.Handshake()
+	data := append([]byte(nil), c.Bytes()...)
+	if len(data) < 5 {
+		t.Fatal("no hello")
+	}
+	return data[:5+int(binary.BigEndian.Uint16(data[3:5]))]
+}
+func payload(p []byte) []byte {
+	var result []byte
+	for len(p) >= 5 {
+		n := 5 + int(binary.BigEndian.Uint16(p[3:5]))
+		if n > len(p) {
+			return nil
+		}
+		result = append(result, p[5:n]...)
+		p = p[n:]
+	}
+	return result
+}
+func TestFragmentsPreserveRealHello(t *testing.T) {
+	h := hello(t)
+	offset, n := SNIRange(h)
+	if offset < 0 || string(h[offset:offset+n]) != "real.example.test" {
+		t.Fatal("SNI parser")
+	}
+	for _, mode := range []string{"sni", "record", "chunks"} {
+		t.Run(mode, func(t *testing.T) {
+			raw := &captureConn{short: true}
+			conn := NewConn(context.Background(), raw, mode, 31, 0)
+			// Deliberately split record header and body across writes.
+			for _, p := range [][]byte{h[:2], h[2:8], h[8:]} {
+				if n, err := conn.Write(p); err != nil || n != len(p) {
+					t.Fatalf("write: %d %v", n, err)
+				}
+			}
+			if mode == "record" {
+				if !bytes.Equal(payload(raw.Bytes()), h[5:]) {
+					t.Fatal("changed TLS handshake")
+				}
+			} else if !bytes.Equal(raw.Bytes(), h) {
+				t.Fatal("changed wire bytes")
+			}
+		})
+	}
+}
+func TestCancellationInterruptsFragmentDelay(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	raw := new(captureConn)
+	conn := NewConn(ctx, raw, "chunks", 16, time.Second)
+	done := make(chan error, 1)
+	go func() { _, err := conn.Write(hello(t)); done <- err }()
+	time.Sleep(20 * time.Millisecond)
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected cancellation")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("delay not canceled")
+	}
+}
+func TestCloseInterruptsFragmentDelay(t *testing.T) {
+	conn := NewConn(context.Background(), new(captureConn), "chunks", 16, time.Second)
+	h := hello(t)
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() { defer wg.Done(); _, _ = conn.Write(h) }()
+	time.Sleep(20 * time.Millisecond)
+	conn.Close()
+	wg.Wait()
+}
+func FuzzSNIRange(f *testing.F) {
+	f.Add([]byte{22, 3, 3, 0, 0})
+	f.Fuzz(func(t *testing.T, p []byte) {
+		off, n := SNIRange(p)
+		if off >= 0 && (n < 0 || off+n > len(p)) {
+			t.Fatal("invalid range")
+		}
+	})
+}
diff --git a/common/snispoof/late_reader.go b/common/snispoof/late_reader.go
new file mode 100644
index 000000000..69a1820a2
--- /dev/null
+++ b/common/snispoof/late_reader.go
@@ -0,0 +1,75 @@
+package snispoof
+
+import (
+	"io"
+	"net"
+	"sync"
+)
+
+// LateReader publishes a response body exactly once and closes late bodies
+// after cancellation. Only opt-in SNISpoof HTTP/gRPC streams use this path.
+type LateReader struct {
+	mu          sync.Mutex
+	ready       chan struct{}
+	reader      io.Reader
+	err         error
+	set, closed bool
+	cancel      func()
+}
+
+func NewLateReader(cancel func()) *LateReader {
+	return &LateReader{ready: make(chan struct{}), cancel: cancel}
+}
+func (r *LateReader) Setup(reader io.Reader, err error) {
+	r.mu.Lock()
+	if r.set || r.closed {
+		r.mu.Unlock()
+		if closer, ok := reader.(io.Closer); ok {
+			closer.Close()
+		}
+		return
+	}
+	r.reader = reader
+	r.err = err
+	r.set = true
+	if reader == nil && err == nil {
+		r.err = io.ErrUnexpectedEOF
+	}
+	close(r.ready)
+	r.mu.Unlock()
+}
+func (r *LateReader) Read(p []byte) (int, error) {
+	<-r.ready
+	r.mu.Lock()
+	reader, err, closed := r.reader, r.err, r.closed
+	r.mu.Unlock()
+	if closed {
+		return 0, net.ErrClosed
+	}
+	if err != nil {
+		return 0, err
+	}
+	return reader.Read(p)
+}
+func (r *LateReader) Close() error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil
+	}
+	r.closed = true
+	if !r.set {
+		r.set = true
+		r.err = net.ErrClosed
+		close(r.ready)
+	}
+	reader := r.reader
+	r.mu.Unlock()
+	if r.cancel != nil {
+		r.cancel()
+	}
+	if closer, ok := reader.(io.Closer); ok {
+		return closer.Close()
+	}
+	return nil
+}

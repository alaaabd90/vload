diff --git a/common/tls/snispoof.go b/common/tls/snispoof.go
new file mode 100644
index 000000000..a3f8fa4fb
--- /dev/null
+++ b/common/tls/snispoof.go
@@ -0,0 +1,417 @@
+package tls
+
+import (
+	"context"
+	"fmt"
+	"math/rand/v2"
+	"net"
+	"net/netip"
+	"os"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/common/snispoof"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+type sniConfig struct {
+	Config
+	settings option.SNISpoofOptions
+	logger   logger.ContextLogger
+	epoch    *atomic.Uint64
+	fetchECH bool
+	echCache *sniECHCache
+	echFetch sniECHFetch
+}
+
+func newSNIConfig(o ClientOptions) (Config, error) {
+	s := *o.Options.SNISpoof
+	if s.Strategy == "" {
+		s.Strategy = "auto"
+	}
+	if s.FragmentSize == 0 {
+		s.FragmentSize = 64
+	}
+	if s.MaxCandidates == 0 {
+		s.MaxCandidates = 8
+	}
+	if s.AttemptTimeoutMS == 0 {
+		s.AttemptTimeoutMS = 4000
+	}
+	if s.TotalTimeoutMS == 0 {
+		s.TotalTimeoutMS = 20000
+	}
+	if s.RetryAfterSeconds == 0 {
+		s.RetryAfterSeconds = 120
+	}
+	if s.FakeEnabled {
+		if s.FakeSNI == "" {
+			s.FakeSNI = "api.twitter.com"
+		}
+		if s.FakeTTL == 0 {
+			s.FakeTTL = 8
+		}
+		if s.FakeDelayMS == 0 {
+			s.FakeDelayMS = 10
+		}
+		if !snispoof.ValidFakeName(s.FakeSNI) || s.FakeTTL < 1 || s.FakeTTL > 32 || s.FakeDelayMS < 1 || s.FakeDelayMS > 50 {
+			return nil, fmt.Errorf("SNISpoof: invalid fake hostname, TTL or delay")
+		}
+	}
+	switch s.Strategy {
+	case "auto", "none", "sni", "record", "chunks":
+	default:
+		return nil, fmt.Errorf("SNISpoof: unknown strategy")
+	}
+	if s.FragmentSize < 16 || s.FragmentSize > 4096 || s.DelayMS < 0 || s.DelayMS > 200 || s.MaxCandidates < 1 || s.MaxCandidates > 32 || s.AttemptTimeoutMS < 500 || s.AttemptTimeoutMS > 15000 || s.TotalTimeoutMS < s.AttemptTimeoutMS || s.TotalTimeoutMS > 60000 || s.RetryAfterSeconds < 10 || s.RetryAfterSeconds > 3600 {
+		return nil, fmt.Errorf("SNISpoof: settings outside supported limits")
+	}
+	if o.Options.Insecure || o.Options.DisableSNI || o.Options.Spoof != "" || o.Options.Reality != nil && o.Options.Reality.Enabled || o.Options.KernelTx || o.Options.KernelRx || o.Options.Engine != "" && o.Options.Engine != "go" {
+		return nil, fmt.Errorf("SNISpoof requires verified ordinary TLS, without Reality, raw spoofing or kTLS")
+	}
+	name := o.Options.ServerName
+	if name == "" {
+		name = o.ServerAddress
+	}
+	if name == "" || M.ParseAddr(name).IsValid() {
+		return nil, fmt.Errorf("SNISpoof: set the real TLS server domain")
+	}
+	if s.RequireECH && (o.Options.ECH == nil || !o.Options.ECH.Enabled) {
+		return nil, fmt.Errorf("SNISpoof: ECH is required but not configured")
+	}
+	for _, entry := range s.CandidateIPs {
+		if _, err := netip.ParseAddr(entry); err != nil {
+			if _, err = netip.ParsePrefix(entry); err != nil {
+				return nil, fmt.Errorf("SNISpoof: invalid candidate IP or CIDR %q", entry)
+			}
+		}
+	}
+	if len(s.CandidateIPs) > 32 {
+		return nil, fmt.Errorf("SNISpoof: at most 32 IP/CIDR entries")
+	}
+	// Build the original verified TLS configuration. Off-path options never
+	// reach this function, and ordinary profiles retain their released code path.
+	fetchECH := s.RequireECH && len(o.Options.ECH.Config) == 0 && o.Options.ECH.ConfigPath == ""
+	if fetchECH {
+		o.Options.ECH = nil
+	}
+	o.Options.SNISpoof = nil
+	o.Options.Fragment = false
+	o.Options.RecordFragment = false
+	base, err := NewClientWithOptions(o)
+	if err != nil {
+		return nil, err
+	}
+	return &sniConfig{Config: base, settings: s, logger: o.Logger, epoch: new(atomic.Uint64), fetchECH: fetchECH, echCache: new(sniECHCache)}, nil
+}
+
+func (c *sniConfig) Clone() Config {
+	return &sniConfig{Config: c.Config.Clone(), settings: c.settings, logger: c.logger, epoch: c.epoch, fetchECH: c.fetchECH, echCache: c.echCache, echFetch: c.echFetch}
+}
+func (c *sniConfig) STDConfig() (*STDConfig, error) {
+	return nil, fmt.Errorf("SNISpoof supports TLS over TCP only")
+}
+func (c *sniConfig) ClientHandshake(ctx context.Context, raw net.Conn) (Conn, error) {
+	if c.fetchECH {
+		return nil, fmt.Errorf("SNISpoof ECH bootstrap must complete before the TLS handshake")
+	}
+	strategy := c.settings.Strategy
+	if strategy == "auto" {
+		strategy = "sni"
+	}
+	var fake *snispoof.FakeOptions
+	if c.settings.FakeEnabled {
+		fake = &snispoof.FakeOptions{ServerName: c.settings.FakeSNI, TTL: c.settings.FakeTTL, DelayMS: c.settings.FakeDelayMS}
+		if c.settings.Diagnostics && c.logger != nil {
+			fake.OnQueued = func(n int) {
+				c.logger.InfoContext(ctx, "SNISpoof fake queued: sni=", c.settings.FakeSNI, " ttl=", c.settings.FakeTTL, " bytes=", n, "; real identity unchanged")
+			}
+		}
+	}
+	conn, err := aTLS.ClientHandshake(ctx, snispoof.NewConnWithFake(ctx, raw, strategy, c.settings.FragmentSize, time.Duration(c.settings.DelayMS)*time.Millisecond, fake), c.Config)
+	if err != nil {
+		return nil, fmt.Errorf("SNISpoof TLS/ECH handshake (%s): %w", strategy, err)
+	}
+	if c.settings.RequireECH && !conn.ConnectionState().ECHAccepted {
+		conn.Close()
+		return nil, fmt.Errorf("SNISpoof ECH was not accepted; plaintext fallback is disabled")
+	}
+	return conn, nil
+}
+
+type sniHealth struct {
+	failedUntil time.Time
+	success     time.Time
+	latency     time.Duration
+}
+type sniDialer struct {
+	raw        N.Dialer
+	config     *sniConfig
+	mu         sync.Mutex
+	health     map[string]sniHealth
+	candidates []string
+	generated  time.Time
+	epoch      uint64
+}
+
+// SNICandidates samples a bounded set. Explicit candidates precede discovery.
+// Known Cloudflare ranges are opt-in; certificate verification still binds
+// every connection to the profile's real domain, not to a scanned address.
+func SNICandidates(primary string, settings option.SNISpoofOptions) []string {
+	maxCount := settings.MaxCandidates
+	if maxCount <= 0 {
+		maxCount = 8
+	}
+	if maxCount > 32 {
+		maxCount = 32
+	}
+	result := []string{}
+	seen := map[string]bool{}
+	add := func(s string) {
+		if s != "" && !seen[s] && len(result) < maxCount {
+			seen[s] = true
+			result = append(result, s)
+		}
+	}
+	// Explicit, tested addresses take precedence over the original target.
+	entries := append([]string(nil), settings.CandidateIPs...)
+	if settings.DiscoverCloudflare {
+		entries = append(entries, "104.16.0.0/13", "104.24.0.0/14", "172.64.0.0/13")
+	}
+	for _, s := range entries {
+		if ip, err := netip.ParseAddr(s); err == nil {
+			add(ip.String())
+		}
+	}
+	add(primary)
+	for round := 0; round < maxCount && len(result) < maxCount; round++ {
+		for _, s := range entries {
+			prefix, err := netip.ParsePrefix(s)
+			if err != nil {
+				continue
+			}
+			base := prefix.Masked().Addr()
+			bits := prefix.Bits()
+			if base.Is4() {
+				b := base.As4()
+				for i := 0; i < 4; i++ {
+					for bit := 0; bit < 8; bit++ {
+						if i*8+bit >= bits && rand.IntN(2) == 1 {
+							b[i] |= 1 << uint(7-bit)
+						}
+					}
+				}
+				add(netip.AddrFrom4(b).String())
+			} else {
+				b := base.As16()
+				for i := 0; i < 16; i++ {
+					for bit := 0; bit < 8; bit++ {
+						if i*8+bit >= bits && rand.IntN(2) == 1 {
+							b[i] |= 1 << uint(7-bit)
+						}
+					}
+				}
+				add(netip.AddrFrom16(b).String())
+			}
+		}
+	}
+	return result
+}
+
+func (d *sniDialer) DialContext(ctx context.Context, network string, dest M.Socksaddr) (net.Conn, error) {
+	if N.NetworkName(network) != N.NetworkTCP {
+		return nil, os.ErrInvalid
+	}
+	return d.DialTLSContext(ctx, dest)
+}
+func (d *sniDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+func (d *sniDialer) DialTLSContext(ctx context.Context, dest M.Socksaddr) (Conn, error) {
+	s := d.config.settings
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(s.TotalTimeoutMS)*time.Millisecond)
+	defer cancel()
+	var echConfig []byte
+	if d.config.fetchECH {
+		var err error
+		echConfig, err = d.config.resolveECH(ctx, d.raw)
+		if err != nil {
+			return nil, err
+		}
+	}
+	now := time.Now()
+	epoch := d.config.epoch.Load()
+	d.mu.Lock()
+	if d.epoch != epoch {
+		d.health = make(map[string]sniHealth)
+		d.candidates = nil
+		d.epoch = epoch
+	}
+	if len(d.candidates) == 0 || now.Sub(d.generated) > time.Duration(s.RetryAfterSeconds)*time.Second {
+		d.candidates = SNICandidates(dest.AddrString(), s)
+		d.generated = now
+		// Bound memory when discovery resamples new addresses.
+		for key, h := range d.health {
+			if now.Sub(h.success) > time.Duration(s.RetryAfterSeconds)*time.Second && now.After(h.failedUntil) {
+				delete(d.health, key)
+			}
+		}
+	}
+	candidates := append([]string(nil), d.candidates...)
+	strategies := []string{s.Strategy}
+	if s.Strategy == "auto" {
+		strategies = []string{"sni", "record", "chunks"}
+	}
+	type attempt struct {
+		ip, strategy string
+		ttl          int
+		key          string
+		health       sniHealth
+	}
+	var attempts []attempt
+	ttls := []int{0}
+	if s.FakeEnabled {
+		ttls = []int{s.FakeTTL}
+		if s.FakeAutoTTL {
+			for _, value := range []int{s.FakeTTL - 2, s.FakeTTL - 4, 2} {
+				if value < 1 || value >= s.FakeTTL {
+					continue
+				}
+				found := false
+				for _, v := range ttls {
+					if value == v {
+						found = true
+					}
+				}
+				if !found {
+					ttls = append(ttls, value)
+				}
+			}
+		}
+	}
+	for _, ip := range candidates {
+		for _, ttl := range ttls {
+			for _, method := range strategies {
+				key := fmt.Sprintf("%s/%s/ttl%d", ip, method, ttl)
+				attempts = append(attempts, attempt{ip: ip, strategy: method, ttl: ttl, key: key, health: d.health[key]})
+			}
+		}
+	}
+	d.mu.Unlock()
+	sort.SliceStable(attempts, func(i, j int) bool {
+		a, b := attempts[i].health, attempts[j].health
+		af, bf := now.Before(a.failedUntil), now.Before(b.failedUntil)
+		if af != bf {
+			return !af
+		}
+		ag, bg := !a.success.IsZero() && now.Sub(a.success) < time.Duration(s.RetryAfterSeconds)*time.Second, !b.success.IsZero() && now.Sub(b.success) < time.Duration(s.RetryAfterSeconds)*time.Second
+		if ag != bg {
+			return ag
+		}
+		if ag && bg {
+			return a.latency < b.latency
+		}
+		return false
+	})
+	var last error
+	for _, a := range attempts {
+		if err := ctx.Err(); err != nil {
+			return nil, fmt.Errorf("SNISpoof connection budget: %w (last: %v)", err, last)
+		}
+		// Quarantine failed paths until retry time; if all are quarantined fail
+		// promptly rather than repeating every failing handshake for every stream.
+		if time.Now().Before(a.health.failedUntil) {
+			continue
+		}
+		started := time.Now()
+		attemptCtx, stop := context.WithTimeout(ctx, time.Duration(s.AttemptTimeoutMS)*time.Millisecond)
+		raw, err := d.raw.DialContext(attemptCtx, N.NetworkTCP, M.ParseSocksaddrHostPort(a.ip, dest.Port))
+		var conn Conn
+		if err != nil {
+			err = fmt.Errorf("SNISpoof TCP connect: %w", err)
+		} else {
+			config := d.config.Clone().(*sniConfig)
+			config.settings.Strategy = a.strategy
+			config.settings.FakeTTL = a.ttl
+			if len(echConfig) > 0 {
+				capable, ok := config.Config.(ECHCapableConfig)
+				if !ok {
+					raw.Close()
+					stop()
+					return nil, fmt.Errorf("SNISpoof TLS engine cannot enable ECH")
+				}
+				capable.SetECHConfigList(echConfig)
+				config.fetchECH = false
+			}
+			conn, err = config.ClientHandshake(attemptCtx, raw)
+			if err != nil {
+				raw.Close()
+			}
+		}
+		stop()
+		elapsed := time.Since(started)
+		if ctx.Err() != nil {
+			if conn != nil {
+				conn.Close()
+			}
+			return nil, ctx.Err()
+		}
+		d.mu.Lock()
+		if d.config.epoch.Load() != epoch {
+			d.mu.Unlock()
+			if conn != nil {
+				conn.Close()
+			}
+			return nil, fmt.Errorf("SNISpoof network changed during connection")
+		}
+		if err == nil {
+			d.health[a.key] = sniHealth{success: time.Now(), latency: elapsed}
+		} else {
+			d.health[a.key] = sniHealth{failedUntil: time.Now().Add(time.Duration(s.RetryAfterSeconds) * time.Second)}
+		}
+		d.mu.Unlock()
+		if s.Diagnostics && d.config.logger != nil {
+			if err == nil {
+				d.config.logger.InfoContext(ctx, "SNISpoof connected: ", a.ip, " strategy=", a.strategy, " fake=", s.FakeEnabled, " fake_ttl=", a.ttl, " ECH accepted=", conn.ConnectionState().ECHAccepted, " handshake=", elapsed.Milliseconds(), "ms")
+			} else {
+				d.config.logger.WarnContext(ctx, "SNISpoof attempt: ", a.ip, " strategy=", a.strategy, " fake_ttl=", a.ttl, " ", err)
+			}
+		}
+		if err == nil {
+			return conn, nil
+		}
+		last = err
+	}
+	if last == nil {
+		last = fmt.Errorf("all candidates are cooling down; retry within %d seconds", s.RetryAfterSeconds)
+	}
+	return nil, fmt.Errorf("SNISpoof exhausted verified TLS candidates: %w", last)
+}
+
+// IsSNISpoof lets transports preserve their authority/ALPN while moving TLS
+// into this dialer (needed by the optional full gRPC implementation).
+func IsSNISpoof(config Config) bool { _, ok := config.(*sniConfig); return ok }
+
+func ResetSNISpoof(config Config) {
+	if c, ok := config.(*sniConfig); ok {
+		c.epoch.Add(1)
+	}
+}
+func ResetSNISpoofDialer(dialer N.Dialer) {
+	if d, ok := dialer.(*sniDialer); ok {
+		d.config.epoch.Add(1)
+	}
+}
+
+func SNISpoofTimeout(config Config) time.Duration {
+	if c, ok := config.(*sniConfig); ok {
+		return time.Duration(c.settings.TotalTimeoutMS+3000) * time.Millisecond
+	}
+	return 0
+}
diff --git a/common/tls/snispoof_ech.go b/common/tls/snispoof_ech.go
new file mode 100644
index 000000000..18dc3317f
--- /dev/null
+++ b/common/tls/snispoof_ech.go
@@ -0,0 +1,134 @@
+package tls
+
+import (
+	"bytes"
+	"context"
+	ctls "crypto/tls"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type sniECHCache struct {
+	mu      sync.Mutex
+	config  []byte
+	expires time.Time
+}
+type sniECHFetch func(context.Context, N.Dialer, string) ([]byte, time.Duration, error)
+
+// Bootstrap ECH before the VPN TLS connection exists. Using the VPN's remote
+// DNS transport here can recursively dial the very profile being established.
+// These HTTPS requests use the SAME protected/slot-bound raw dialer and fixed
+// resolver IPs; they never send the real query name in plaintext DNS or SNI.
+func fetchSNIECH(ctx context.Context, raw N.Dialer, name string) ([]byte, time.Duration, error) {
+	message := new(mdns.Msg).SetQuestion(mdns.Fqdn(name), mdns.TypeHTTPS)
+	wire, err := message.Pack()
+	if err != nil {
+		return nil, 0, err
+	}
+	var last error
+	for _, ip := range []string{"1.1.1.1", "1.0.0.1"} {
+		attempt, cancel := context.WithTimeout(ctx, 3*time.Second)
+		transport := &http.Transport{Proxy: nil, DisableKeepAlives: true,
+			DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+				return raw.DialContext(ctx, N.NetworkTCP, M.ParseSocksaddrHostPort(ip, 443))
+			},
+			TLSClientConfig: &ctls.Config{ServerName: "cloudflare-dns.com", MinVersion: ctls.VersionTLS12},
+		}
+		client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+		req, err := http.NewRequestWithContext(attempt, http.MethodPost, "https://cloudflare-dns.com/dns-query", bytes.NewReader(wire))
+		if err != nil {
+			cancel()
+			return nil, 0, err
+		}
+		req.Header.Set("Content-Type", "application/dns-message")
+		req.Header.Set("Accept", "application/dns-message")
+		response, err := client.Do(req)
+		var config []byte
+		var ttl time.Duration
+		if err == nil {
+			if response.StatusCode != http.StatusOK {
+				err = fmt.Errorf("ECH resolver returned HTTP %d", response.StatusCode)
+			} else {
+				var body []byte
+				body, err = io.ReadAll(io.LimitReader(response.Body, 65537))
+				if err == nil {
+					if len(body) > 65536 {
+						err = fmt.Errorf("ECH DNS response too large")
+					} else {
+						config, ttl, err = parseSNIECHResponse(body, message)
+					}
+				}
+			}
+			response.Body.Close()
+		}
+		transport.CloseIdleConnections()
+		cancel()
+		if err == nil {
+			return config, ttl, nil
+		}
+		last = err
+		if ctx.Err() != nil {
+			return nil, 0, ctx.Err()
+		}
+	}
+	return nil, 0, fmt.Errorf("SNISpoof ECH bootstrap failed (encrypted DNS); supply an ECH configuration in this profile: %w", last)
+}
+
+func parseSNIECHResponse(body []byte, query *mdns.Msg) ([]byte, time.Duration, error) {
+	var message mdns.Msg
+	if err := message.Unpack(body); err != nil {
+		return nil, 0, err
+	}
+	if !message.Response || message.Id != query.Id || message.Rcode != mdns.RcodeSuccess || len(message.Question) != 1 || message.Question[0] != query.Question[0] {
+		return nil, 0, fmt.Errorf("invalid ECH DNS response")
+	}
+	for _, rr := range message.Answer {
+		if record, ok := rr.(*mdns.HTTPS); ok {
+			for _, value := range record.Value {
+				if value.Key() == mdns.SVCB_ECHCONFIG {
+					config, err := base64.StdEncoding.DecodeString(value.String())
+					if err != nil {
+						return nil, 0, err
+					}
+					if len(config) < 2 {
+						return nil, 0, fmt.Errorf("empty ECH config")
+					}
+					return config, time.Duration(min(record.Hdr.Ttl, 3600)) * time.Second, nil
+				}
+			}
+		}
+	}
+	return nil, 0, fmt.Errorf("the real domain has no ECH configuration")
+}
+
+func (c *sniConfig) resolveECH(ctx context.Context, raw N.Dialer) ([]byte, error) {
+	c.echCache.mu.Lock()
+	cached := append([]byte(nil), c.echCache.config...)
+	expires := c.echCache.expires
+	c.echCache.mu.Unlock()
+	if len(cached) > 0 && time.Now().Before(expires) {
+		return cached, nil
+	}
+	fetch := c.echFetch
+	if fetch == nil {
+		fetch = fetchSNIECH
+	}
+	config, ttl, err := fetch(ctx, raw, c.ServerName())
+	if err != nil {
+		return nil, err
+	}
+	c.echCache.mu.Lock()
+	c.echCache.config = append([]byte(nil), config...)
+	c.echCache.expires = time.Now().Add(ttl)
+	c.echCache.mu.Unlock()
+	return config, nil
+}

diff --git a/common/snispoof/fake.go b/common/snispoof/fake.go
new file mode 100644
index 000000000..658004196
--- /dev/null
+++ b/common/snispoof/fake.go
@@ -0,0 +1,76 @@
+package snispoof
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"fmt"
+	"strings"
+)
+
+// FakeOptions affects only the first ClientHello, never the verified TLS identity.
+type FakeOptions struct {
+	ServerName string
+	TTL        int
+	DelayMS    int
+	OnQueued   func(int)
+}
+
+func ValidFakeName(name string) bool {
+	if len(name) == 0 || len(name) > 253 || !strings.Contains(name, ".") {
+		return false
+	}
+	for _, label := range strings.Split(name, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, c := range label {
+			if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// FakeHello constructs a complete TLS 1.2 decoy, with fresh randomness and
+// padding to the exact sequence-space length that will later carry real bytes.
+// No real ClientHello secrets, session IDs, hostname or ECH payload are copied.
+func FakeHello(name string, size int) ([]byte, error) {
+	if !ValidFakeName(name) || size < 256 || size > 1200 {
+		return nil, fmt.Errorf("invalid fake hostname or hello size")
+	}
+	p := []byte{22, 3, 1, 0, 0, 1, 0, 0, 0, 3, 3}
+	random := make([]byte, 65)
+	if _, err := rand.Read(random); err != nil {
+		return nil, err
+	}
+	p = append(p, random[:32]...)
+	p = append(p, 32)
+	p = append(p, random[32:64]...)
+	p = append(p, 0, 8, 0xc0, 0x2f, 0xc0, 0x2b, 0xc0, 0x30, 0xc0, 0x2c, 1, 0)
+	extLen := len(p)
+	p = append(p, 0, 0)
+	add := func(typ uint16, body []byte) {
+		p = binary.BigEndian.AppendUint16(p, typ)
+		p = binary.BigEndian.AppendUint16(p, uint16(len(body)))
+		p = append(p, body...)
+	}
+	sni := binary.BigEndian.AppendUint16(nil, uint16(len(name)+3))
+	sni = append(sni, 0)
+	sni = binary.BigEndian.AppendUint16(sni, uint16(len(name)))
+	sni = append(sni, name...)
+	add(0, sni)
+	add(10, []byte{0, 4, 0, 29, 0, 23})
+	add(11, []byte{1, 0})
+	add(13, []byte{0, 8, 4, 3, 8, 4, 4, 1, 5, 3})
+	add(23, nil)
+	if size-len(p) < 4 {
+		return nil, fmt.Errorf("fake hostname exceeds hello capacity")
+	}
+	add(21, make([]byte, size-len(p)-4))
+	binary.BigEndian.PutUint16(p[extLen:extLen+2], uint16(len(p)-extLen-2))
+	binary.BigEndian.PutUint16(p[3:5], uint16(len(p)-5))
+	n := len(p) - 9
+	p[6], p[7], p[8] = byte(n>>16), byte(n>>8), byte(n)
+	return p, nil
+}
diff --git a/common/snispoof/fake_linux.go b/common/snispoof/fake_linux.go
new file mode 100644
index 000000000..b20f5dbda
--- /dev/null
+++ b/common/snispoof/fake_linux.go
@@ -0,0 +1,159 @@
+//go:build linux
+
+package snispoof
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"syscall"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+	"golang.org/x/sys/unix"
+)
+
+// SendFakePrefix uses a normal connected TCP socket, not a raw socket. A short
+// TTL limits the decoy's reach. vmsplice/splice retain the mapped pages in the
+// retransmission queue; after the first transmission we replace those pages
+// with the real prefix and restore the original socket TTL. This technique is
+// described/implemented by hufrea/ByeDPI (MIT); see NOTICE-byedpi.txt.
+//
+// TTL must expire after the observer but before the server. A successful TLS
+// handshake alone cannot prove a DPI observer saw the decoy. No silent fallback
+// is allowed when this mechanism is unsupported or a syscall fails.
+func SendFakePrefix(ctx context.Context, conn net.Conn, original []byte, opt FakeOptions) (sent int, err error) {
+	if opt.TTL < 1 || opt.TTL > 32 || opt.DelayMS < 1 || opt.DelayMS > 50 {
+		return 0, fmt.Errorf("invalid fake TTL or delay")
+	}
+	n := min(1200, len(original)-1)
+	fake, err := FakeHello(opt.ServerName, n)
+	if err != nil {
+		return 0, err
+	}
+	socket, ok := N.UnwrapWriter(conn).(syscall.Conn)
+	if !ok {
+		return 0, fmt.Errorf("fake SNI needs a direct TCP socket; this dialer does not expose one")
+	}
+	raw, err := socket.SyscallConn()
+	if err != nil {
+		return 0, err
+	}
+	mem, err := unix.Mmap(-1, 0, 4096, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_PRIVATE|unix.MAP_ANON)
+	if err != nil {
+		return 0, fmt.Errorf("fake mmap: %w", err)
+	}
+	copy(mem, fake)
+	defer unix.Munmap(mem)
+	// On every exit, including cancellation or a partial send, queued pages must
+	// contain the original stream. The socket is closed on failure.
+	defer func() {
+		copy(mem, original[:n])
+		if err != nil {
+			conn.Close()
+		}
+	}()
+	pipe := []int{0, 0}
+	if err = unix.Pipe2(pipe, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+		return 0, fmt.Errorf("fake pipe: %w", err)
+	}
+	defer unix.Close(pipe[0])
+	defer unix.Close(pipe[1])
+	vec := []unix.Iovec{{Base: &mem[0]}}
+	vec[0].SetLen(n)
+	queued, err := unix.Vmsplice(pipe[1], vec, unix.SPLICE_F_GIFT|unix.SPLICE_F_NONBLOCK)
+	if err != nil || queued != n {
+		return 0, fmt.Errorf("fake vmsplice queued %d/%d: %v", queued, n, err)
+	}
+	level, option := unix.IPPROTO_IP, unix.IP_TTL
+	if addr, ok := conn.RemoteAddr().(*net.TCPAddr); ok && addr.IP.To4() == nil {
+		level, option = unix.IPPROTO_IPV6, unix.IPV6_UNICAST_HOPS
+	}
+	var operation error
+	var oldTTL int
+	err = raw.Control(func(fd uintptr) {
+		oldTTL, operation = unix.GetsockoptInt(int(fd), level, option)
+		if operation == nil {
+			operation = unix.SetsockoptInt(int(fd), level, option, opt.TTL)
+		}
+	})
+	if err != nil {
+		return 0, err
+	}
+	if operation != nil {
+		return 0, fmt.Errorf("fake TTL: %w", operation)
+	}
+	defer func() {
+		var restore error
+		control := raw.Control(func(fd uintptr) { restore = unix.SetsockoptInt(int(fd), level, option, oldTTL) })
+		if err == nil && (control != nil || restore != nil) {
+			err = fmt.Errorf("restore fake TTL: %v %v", control, restore)
+			conn.Close()
+		}
+	}()
+	stopCancel := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stopCancel()
+	err = raw.Write(func(fd uintptr) bool {
+		if operation = ctx.Err(); operation != nil {
+			return true
+		}
+		count, e := unix.Splice(pipe[0], nil, int(fd), nil, n-sent, unix.SPLICE_F_NONBLOCK)
+		if count > 0 {
+			sent += int(count)
+		}
+		if e == unix.EINTR || e == unix.EAGAIN {
+			return false
+		}
+		operation = e
+		return e != nil || sent == n
+	})
+	if err != nil {
+		return sent, err
+	}
+	if operation != nil {
+		return sent, fmt.Errorf("fake splice: %w", operation)
+	}
+	if sent != n {
+		return sent, fmt.Errorf("fake short splice: %d/%d", sent, n)
+	}
+	// Wait briefly for the first copy to leave the socket, before updating its
+	// retransmission pages. Bound the wait and honor handshake cancellation.
+	until := time.Now().Add(50 * time.Millisecond)
+	for {
+		var unsent uint32
+		err = raw.Control(func(fd uintptr) {
+			info, e := unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+			operation = e
+			if e == nil {
+				unsent = info.Notsent_bytes
+			}
+		})
+		if err != nil {
+			return sent, err
+		}
+		if operation != nil {
+			return sent, operation
+		}
+		if unsent == 0 {
+			break
+		}
+		if time.Now().After(until) {
+			return sent, fmt.Errorf("fake initial transmission did not leave the socket")
+		}
+		select {
+		case <-ctx.Done():
+			return sent, ctx.Err()
+		case <-time.After(time.Millisecond):
+		}
+	}
+	select {
+	case <-ctx.Done():
+		return sent, ctx.Err()
+	case <-time.After(time.Duration(opt.DelayMS) * time.Millisecond):
+	}
+	copy(mem, original[:n])
+	if opt.OnQueued != nil {
+		opt.OnQueued(sent)
+	}
+	return sent, nil
+}

+package mux
+
+import (
+	"bytes"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type trackedResponseBody struct {
+	*bytes.Reader
+	closes atomic.Int32
+}
+
+func (r *trackedResponseBody) Close() error { r.closes.Add(1); return nil }
+func TestHTTPConnCloseDuringResponseSetup(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		c := newLateHTTPConn(io.Discard, func() {})
+		body := &trackedResponseBody{Reader: bytes.NewReader([]byte("x"))}
+		var wg sync.WaitGroup
+		wg.Add(3)
+		go func() { defer wg.Done(); c.setup(body, nil) }()
+		go func() { defer wg.Done(); c.Close() }()
+		go func() { defer wg.Done(); c.Read(make([]byte, 1)) }()
+		wg.Wait()
+		if body.closes.Load() != 1 {
+			t.Fatalf("response closed %d times", body.closes.Load())
+		}
+	}

diff --git a/client_pool_test.go b/client_pool_test.go
new file mode 100644
index 0000000..1e86e75
--- /dev/null
+++ b/client_pool_test.go
@@ -0,0 +1,155 @@
+package mux
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type stalledPoolDialer struct {
+	started chan struct{}
+	once    sync.Once
+}
+
+type availablePoolSession struct{ closed atomic.Bool }
+
+func (*availablePoolSession) Open() (net.Conn, error)   { return nil, errors.New("unused") }
+func (*availablePoolSession) Accept() (net.Conn, error) { return nil, errors.New("unused") }
+func (*availablePoolSession) NumStreams() int           { return 4 }
+func (s *availablePoolSession) Close() error            { s.closed.Store(true); return nil }
+func (s *availablePoolSession) IsClosed() bool          { return s.closed.Load() }
+func (*availablePoolSession) CanTakeNewRequest() bool   { return true }
+
+func TestPoolHealthySessionAvailableDuringSlowGrowth(t *testing.T) {
+	d := &stalledPoolDialer{started: make(chan struct{})}
+	c, _ := NewClient(Options{Dialer: d, Protocol: "yamux", MaxConnections: 2, MinStreams: 4})
+	existing := &availablePoolSession{}
+	c.connections.PushBack(existing)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { c.offer(ctx); close(done) }()
+	<-d.started
+	waiting, stop := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer stop()
+	got, err := c.offer(waiting)
+	cancel()
+	<-done
+	if err != nil || got != existing {
+		t.Fatalf("healthy session blocked behind pool growth: %v", err)
+	}
+	c.Reset()
+	if !existing.closed.Load() {
+		t.Fatal("reset did not close existing session")
+	}
+}
+
+func (d *stalledPoolDialer) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	d.once.Do(func() { close(d.started) })
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+func (*stalledPoolDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("unused")
+}
+
+func TestPoolResetCancelsPendingDial(t *testing.T) {
+	d := &stalledPoolDialer{started: make(chan struct{})}
+	c, _ := NewClient(Options{Dialer: d, Protocol: "yamux"})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { c.offer(ctx); close(done) }()
+	<-d.started
+	reset := make(chan struct{})
+	go func() { c.Reset(); close(reset) }()
+	select {
+	case <-reset:
+	case <-time.After(250 * time.Millisecond):
+		cancel()
+		<-done
+		<-reset
+		t.Fatal("network reset blocked behind pending mux dial")
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("reset did not cancel pending mux dial")
+	}
+}
+
+func TestPoolWaitRespectsCallerCancellation(t *testing.T) {
+	d := &stalledPoolDialer{started: make(chan struct{})}
+	c, _ := NewClient(Options{Dialer: d, Protocol: "yamux"})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { c.offer(ctx); close(done) }()
+	<-d.started
+	waiting, stop := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer stop()
+	result := make(chan error, 1)
+	go func() { _, err := c.offer(waiting); result <- err }()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatal(err)
+		}
+	case <-time.After(250 * time.Millisecond):
+		cancel()
+		<-done
+		<-result
+		t.Fatal("pool mutex ignored waiting caller deadline")
+	}
+	cancel()
+	<-done
+}
+
+// Even the caller that triggers growth should use an existing usable session.
+func TestPoolGrowthInitiatorDoesNotWaitForSlowDial(t *testing.T) {
+	d := &stalledPoolDialer{started: make(chan struct{})}
+	c, _ := NewClient(Options{Dialer: d, Protocol: "yamux", MaxConnections: 2, MinStreams: 4})
+	existing := &availablePoolSession{}
+	c.connections.PushBack(existing)
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	got, err := c.offer(ctx)
+	defer c.Reset()
+	if err != nil || got != existing {
+		t.Fatalf("growth initiator stalled despite usable session: %v", err)
+	}
+	select {
+	case <-d.started:
+	case <-time.After(time.Second):
+		t.Fatal("pool did not start growth")
+	}
+}
+
+func TestBackgroundGrowthIsCancelledByReset(t *testing.T) {
+	d := &stalledPoolDialer{started: make(chan struct{})}
+	c, _ := NewClient(Options{Dialer: d, Protocol: "yamux", MaxConnections: 2, MinStreams: 4})
+	c.connections.PushBack(&availablePoolSession{})
+	if _, err := c.offer(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	<-d.started
+	c.access.Lock()
+	pending := c.pending
+	c.access.Unlock()
+	c.Reset()
+	select {
+	case <-pending.done:
+	case <-time.After(time.Second):
+		t.Fatal("growth leaked after reset")
+	}
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.connections.Len() != 0 {
+		t.Fatal("reset repopulated pool")
+	}
+}

+++ b/client_recovery_test.go
@@ -0,0 +1,145 @@
+package mux
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"net"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type recoveryDialer struct{ address string }
+
+func (d recoveryDialer) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	return (&net.Dialer{}).DialContext(ctx, "tcp", d.address)
+}
+func (recoveryDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("unused")
+}
+
+// A reloaded server can leave its mux transport alive with a closed DNS router.
+func TestPoolRecoversFromClosedRemoteDNSRouter(t *testing.T) {
+	testPoolRemoteError(t, "open connection using outbound/direct[direct]: dns router closed", true)
+}
+func TestPoolDoesNotRetireOnDestinationErrors(t *testing.T) {
+	for _, message := range []string{"lookup example.com: NXDOMAIN", "lookup example.com: unexpected status: 403 Forbidden"} {
+		t.Run(message, func(t *testing.T) { testPoolRemoteError(t, message, false) })
+	}
+}
+func testPoolRemoteError(t *testing.T, message string, shouldRetire bool) {
+	for _, protocol := range []string{"yamux", "smux", "h2mux"} {
+		for _, mode := range []string{"tcp", "udp", "packet"} {
+			t.Run(protocol+"/"+mode, func(t *testing.T) {
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer listener.Close()
+				var accepts atomic.Int32
+				go func() {
+					for {
+						conn, err := listener.Accept()
+						if err != nil {
+							return
+						}
+						number := accepts.Add(1)
+						go func() {
+							defer conn.Close()
+							req, err := ReadRequest(conn)
+							if err != nil {
+								return
+							}
+							session, err := newServerSession(conn, req.Protocol)
+							if err != nil {
+								return
+							}
+							defer session.Close()
+							for {
+								stream, err := session.Accept()
+								if err != nil {
+									return
+								}
+								go func() {
+									defer stream.Close()
+									stream.SetDeadline(time.Now().Add(2 * time.Second))
+									if _, err := ReadStreamRequest(stream); err != nil {
+										return
+									}
+									one := make([]byte, 1)
+									if _, err := io.ReadFull(stream, one); err != nil {
+										return
+									}
+									response := &serverConn{ExtendedConn: bufio.NewExtendedConn(stream)}
+									if number == 1 {
+										response.HandshakeFailure(errors.New(message))
+									} else {
+										response.Write([]byte("Y"))
+									}
+								}()
+							}
+						}()
+					}
+				}()
+				client, err := NewClient(Options{Dialer: recoveryDialer{listener.Addr().String()}, Protocol: protocol, MaxConnections: 1})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer client.Close()
+				request := func() error {
+					ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+					defer cancel()
+					if mode == "packet" {
+						conn, err := client.ListenPacket(ctx, M.ParseSocksaddr("example.com:443"))
+						if err != nil {
+							return err
+						}
+						defer conn.Close()
+						conn.SetDeadline(time.Now().Add(2 * time.Second))
+						if _, err = conn.WriteTo([]byte("X"), M.ParseSocksaddr("example.com:443")); err != nil {
+							return err
+						}
+						_, _, err = conn.ReadFrom(make([]byte, 32))
+						return err
+					}
+					conn, err := client.DialContext(ctx, mode, M.ParseSocksaddr("example.com:443"))
+					if err != nil {
+						return err
+					}
+					defer conn.Close()
+					conn.SetDeadline(time.Now().Add(2 * time.Second))
+					if _, err = conn.Write([]byte("X")); err != nil {
+						return err
+					}
+					one := make([]byte, 1)
+					_, err = io.ReadFull(conn, one)
+					return err
+				}
+				if err = request(); err == nil || !strings.Contains(err.Error(), message) {
+					t.Fatalf("expected closed router: %v", err)
+				}
+				mode = "tcp"
+				err = request()
+				if shouldRetire {
+					if err != nil {
+						t.Fatalf("pool reused a closed remote router: %v", err)
+					}
+					if accepts.Load() != 2 {
+						t.Fatalf("expected replacement tunnel, got %d", accepts.Load())
+					}
+				} else {
+					if err == nil || !strings.Contains(err.Error(), message) {
+						t.Fatalf("expected per-destination error, got %v", err)
+					}
+					if accepts.Load() != 1 {
+						t.Fatal("destination failure discarded a healthy tunnel")
+					}
+				}
+			})
+		}
+	}
+}

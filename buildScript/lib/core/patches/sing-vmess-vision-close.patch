+// Close must not write an outer TLS close_notify into a stream that has
+// switched to raw forwarding: the peer would interpret it as destination data.
+// Atomic flags allow shutdown to observe the independent read/write paths.
+func (c *VisionConn) Close() error {
+	if c.directRead.Load() || c.directWrite.Load() {
+		return c.netConn.Close()
+	}
+	return c.Conn.Close()
+}
+
 func (c *VisionConn) NeedAdditionalReadDeadline() bool {
 	return true
 }
diff --git a/vless/vision_close_test.go b/vless/vision_close_test.go
new file mode 100644
index 0000000..0802a4e
--- /dev/null
+++ b/vless/vision_close_test.go
@@ -0,0 +1,67 @@
+package vless
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestVisionCloseDoesNotAppendOuterTLSRecord(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), DNSNames: []string{"localhost"}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool := x509.NewCertPool()
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool.AddCert(cert)
+	for _, mode := range []string{"read", "write"} {
+		t.Run(mode, func(t *testing.T) {
+			serverRaw, clientRaw := net.Pipe()
+			defer serverRaw.Close()
+			defer clientRaw.Close()
+			server := tls.Server(serverRaw, &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}, SessionTicketsDisabled: true, MinVersion: tls.VersionTLS13})
+			client := tls.Client(clientRaw, &tls.Config{RootCAs: pool, ServerName: "localhost", MinVersion: tls.VersionTLS13})
+			done := make(chan error, 1)
+			go func() { done <- server.Handshake() }()
+			if err := client.Handshake(); err != nil {
+				t.Fatal(err)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			vision := &VisionConn{Conn: server, netConn: serverRaw}
+			if mode == "read" {
+				vision.directRead.Store(true)
+			} else {
+				vision.directWrite.Store(true)
+			}
+			go func() { done <- vision.Close() }()
+			clientRaw.SetReadDeadline(time.Now().Add(2 * time.Second))
+			data := make([]byte, 1024)
+			n, err := clientRaw.Read(data)
+			if n != 0 {
+				t.Fatalf("Vision close injected %d bytes into raw stream", n)
+			}
+			if err == nil {
+				t.Fatal("expected EOF after raw socket close")
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
